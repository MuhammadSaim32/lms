# Server sample environment variables
# Copy this file to `.env.development` or `.env.production` and fill values.

# App
PORT=8000
NODE_ENV=development

# Database
# MongoDB connection string
DB_URI=mongodb://localhost:27017/lms

# JWT / Tokens
ACCESS_TOKEN_SECRET=replace_with_a_random_secret
REFRESH_TOKEN_EXPIRES_IN=60    # minutes
ACCESS_TOKEN_EXPIRES_IN=15     # minutes

# Cloudinary (for image uploads)
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Email (used by nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password

# Stripe
STRIPE_SECRET_KEY=sk_test_yourkey
WEBHOOK_SECRET=whsec_yourwebhooksecret

# Client / Frontend URLs
CLIENT_URL=http://localhost:3000
ORIGIN=http://localhost:3000

# Misc / Test user seed
TEST_USER_EMAIL=test@test.com
TEST_USER_NAME=test
TEST_USER_PASSWORD=test@test.com
