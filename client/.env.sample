# Client (Next.js) sample environment variables
# Copy to `.env.local` and customize.

# Base API URL that points to the server API (must include /api/v1 if used)
NEXT_PUBLIC_SERVER_URI=http://localhost:8000/api/v1

# OAuth / Social auth
# Note: code references NEXT_PUBLIC_GOOGE_CLIENT_ID (typo). We include both keys.
NEXT_PUBLIC_GOOGE_CLIENT_ID=your_google_client_id
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
NEXT_PUBLIC_GOOGLE_URI=https://accounts.google.com/o/oauth2/v2/auth

# GitHub OAuth (authorize URL)
NEXT_PUBLIC_GITHUB_URI=https://github.com/login/oauth/authorize?client_id=your_github_client_id
